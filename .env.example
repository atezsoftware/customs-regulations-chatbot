# Default chat provider: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
FS_EXPLORER_LLM_PROVIDER=openrouter
FS_EXPLORER_LLM_MODEL=google/gemini-3.6-flash
OPENROUTER_DEFAULT_MODEL=google/gemini-3.6-flash
OPENROUTER_CATALOG_SYNC_MINUTES=60
# Optional but recommended for provider analytics/routing policies.
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=Customs Regulations Chatbot

# Role-specific multi-agent model policy. Each role can be changed
# independently without changing the legacy session model selector above.
FS_EXPLORER_PLANNER_PROVIDER=openrouter
FS_EXPLORER_PLANNER_MODEL=openai/gpt-5.6-sol
FS_EXPLORER_PLANNER_REASONING=medium
FS_EXPLORER_TASK_PROVIDER=openrouter
FS_EXPLORER_TASK_MODEL=google/gemini-3.6-flash
FS_EXPLORER_TASK_REASONING=medium
FS_EXPLORER_WORKER_PROVIDER=openrouter
FS_EXPLORER_WORKER_MODEL=google/gemini-3.5-flash-lite
FS_EXPLORER_WORKER_REASONING=low
FS_EXPLORER_FINAL_PROVIDER=openrouter
FS_EXPLORER_FINAL_MODEL=google/gemini-3.6-flash
FS_EXPLORER_FINAL_REASONING=high
FS_EXPLORER_MULTI_AGENT_MAX_TASKS=5
FS_EXPLORER_MULTI_AGENT_MAX_WORKERS_PER_TASK=3
FS_EXPLORER_MULTI_AGENT_MAX_WORKER_ROUNDS=2
FS_EXPLORER_MULTI_AGENT_MAX_TOTAL_WORKERS=8
FS_EXPLORER_MULTI_AGENT_MAX_LLM_CALLS=24
FS_EXPLORER_MULTI_AGENT_MAX_ARTIFACT_ITEMS=12
FS_EXPLORER_MULTI_AGENT_MAX_ARTIFACT_CONTEXT_CHARS=16000
FS_EXPLORER_MULTI_AGENT_MAX_QUESTION_CHARS=8000
FS_EXPLORER_MULTI_AGENT_MAX_PLANNER_CONTEXT_CHARS=16000
FS_EXPLORER_MULTI_AGENT_MAX_FINAL_CONTEXT_CHARS=48000
FS_EXPLORER_MULTI_AGENT_SEARCH_TIMEOUT_SECONDS=20
FS_EXPLORER_MULTI_AGENT_LLM_TIMEOUT_SECONDS=120

# Optional Gemini key for indexing or fallback flows.
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: dedicated key for langextract metadata mode.
# If unset, indexing will fall back to GOOGLE_API_KEY.
# LANGEXTRACT_API_KEY=your_api_key_here

# Optional: override langextract model used by `explore index --with-metadata`.
# FS_EXPLORER_LANGEXTRACT_MODEL=gemini-3-flash-preview

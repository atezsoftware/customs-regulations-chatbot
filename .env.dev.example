# Single reference for everything needed to run the whole stack locally in dev.
# Copy to `.env` (core reads it for GOOGLE_API_KEY), to `backend/.env`
# (backend reads DB_*/JWT_*/STORAGE_ROOT), and to `frontend/.env`
# (frontend reads VITE_API_URL). `scripts/run.sh --env dev` assumes this has
# already been done.

NODE_ENV=local

# --- core (Python AI engine, split into two services) ---
# OpenRouter is the default chat provider.
OPENROUTER_API_KEY=
FS_EXPLORER_LLM_PROVIDER=openrouter
FS_EXPLORER_LLM_MODEL=google/gemini-3.6-flash
OPENROUTER_DEFAULT_MODEL=google/gemini-3.6-flash
OPENROUTER_CATALOG_SYNC_MINUTES=60
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Customs Regulations Chatbot (Local Dev)

# Multi-agent research role policy.
FS_EXPLORER_PLANNER_PROVIDER=openrouter
FS_EXPLORER_PLANNER_MODEL=openai/gpt-5.6-sol
FS_EXPLORER_PLANNER_REASONING=medium
FS_EXPLORER_TASK_PROVIDER=openrouter
FS_EXPLORER_TASK_MODEL=google/gemini-3.6-flash
FS_EXPLORER_TASK_REASONING=medium
FS_EXPLORER_WORKER_PROVIDER=openrouter
FS_EXPLORER_WORKER_MODEL=google/gemini-3.5-flash-lite
FS_EXPLORER_WORKER_REASONING=low
FS_EXPLORER_FINAL_PROVIDER=openrouter
FS_EXPLORER_FINAL_MODEL=google/gemini-3.6-flash
FS_EXPLORER_FINAL_REASONING=high
FS_EXPLORER_MULTI_AGENT_MAX_TASKS=5
FS_EXPLORER_MULTI_AGENT_MAX_WORKERS_PER_TASK=3
FS_EXPLORER_MULTI_AGENT_MAX_WORKER_ROUNDS=4
FS_EXPLORER_MULTI_AGENT_MAX_TOTAL_WORKERS=12
FS_EXPLORER_MULTI_AGENT_MAX_LLM_CALLS=24
FS_EXPLORER_MULTI_AGENT_MAX_ARTIFACT_ITEMS=12
FS_EXPLORER_MULTI_AGENT_MAX_ARTIFACT_CONTEXT_CHARS=16000
FS_EXPLORER_MULTI_AGENT_MAX_QUESTION_CHARS=8000
FS_EXPLORER_MULTI_AGENT_MAX_PLANNER_CONTEXT_CHARS=16000
FS_EXPLORER_MULTI_AGENT_MAX_FINAL_CONTEXT_CHARS=48000
FS_EXPLORER_MULTI_AGENT_SEARCH_TIMEOUT_SECONDS=20
FS_EXPLORER_MULTI_AGENT_LLM_TIMEOUT_SECONDS=120

# Optional if you still want Gemini available for indexing or direct fallback.
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
CORE_INTERNAL_TOKEN=dev-internal-token
# core-indexer also reads FS_EXPLORER_LANGEXTRACT_MODEL/FS_EXPLORER_LANGEXTRACT_MAX_CHARS
# (optional, see core/CLAUDE.md) for the langextract metadata extraction step.


# --- db (must match db/.env.dev) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=customs_dev
DB_PASSWORD=change-me-dev
DB_NAME=customs_dev
DATABASE_URL=postgresql://customs_dev:change-me-dev@localhost:5432/customs_dev

# --- backend auth ---
# In local, auth/* still works normally, but every OTHER endpoint treats
# requests as a fixed dev user automatically (no login required), and file
# uploads are enabled — this only happens when NODE_ENV=local. Required
# (real auth, uploads disabled) in development/test/prod.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- backend file storage ---
STORAGE_ROOT=./storage
PORT=3000
# core-api: chat/agent service (/ws/explore, /api/search)
CORE_INTERNAL_URL=ws://127.0.0.1:8000
# core-indexer: Docling/langextract indexing service (/api/index*)
CORE_INDEXER_URL=http://127.0.0.1:8001

# --- frontend ---
VITE_API_URL=http://localhost:3000

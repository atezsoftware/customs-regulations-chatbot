# Copy this file to .env.regulatory-importer, fill every required blank, and
# keep the completed file out of source control. Paths must be absolute host paths.

# Required. Use the digest emitted by publish-regulatory-images.sh for the same
# application/schema release deployed in production; do not use latest.
ONYX_IMPORTER_IMAGE=registry.example.com/team/regulatory-importer@sha256:replace-with-published-digest
# Pass the promoted REGULATORY_SOURCE_REVISION separately to
# regulatory-import-run.sh --expected-revision; do not infer it from a tag.

IMPORTER_SOURCE_DIR=
IMPORTER_OUTPUT_DIR=
IMPORTER_CA_BUNDLE_PATH=
# Set these from `id -u` and `id -g` on the machine running the importer.
IMPORTER_UID=1000
IMPORTER_GID=1000

# Tenant and encrypted credentials must match production exactly.
IMPORTER_MULTI_TENANT=false
IMPORTER_POSTGRES_DEFAULT_SCHEMA=public
IMPORTER_ENCRYPTION_KEY_SECRET=
IMPORTER_ONYX_DB_SHARDS=
IMPORTER_ONYX_DB_DEFAULT_SHARD=default
IMPORTER_ONYX_DB_CATALOG_SHARD=default

# PostgreSQL. Prefer verify-full; use a VPN or SSH tunnel rather than exposing it publicly.
# For a host-side tunnel use host.docker.internal after following the README binding guidance.
IMPORTER_POSTGRES_HOST=
IMPORTER_POSTGRES_PORT=5432
IMPORTER_POSTGRES_DB=
IMPORTER_POSTGRES_USER=
IMPORTER_POSTGRES_PASSWORD=
IMPORTER_USE_IAM_AUTH=false
IMPORTER_POSTGRES_SSLMODE=verify-full

# Elasticsearch. Connect to the same self-managed cluster used by the API.
IMPORTER_ELASTICSEARCH_HOST=
IMPORTER_ELASTICSEARCH_PORT=9200
IMPORTER_ELASTICSEARCH_USERNAME=
IMPORTER_ELASTICSEARCH_PASSWORD=
IMPORTER_ELASTICSEARCH_USE_SSL=true
IMPORTER_ELASTICSEARCH_VERIFY_CERTS=true

# Object store. For FILE_STORE_BACKEND=postgres, leave the S3 fields blank.
# For AWS S3, S3_ENDPOINT_URL is normally blank; for MinIO use its HTTPS endpoint.
IMPORTER_FILE_STORE_BACKEND=s3
IMPORTER_S3_ENDPOINT_URL=
IMPORTER_S3_ACCESS_KEY_ID=
IMPORTER_S3_SECRET_ACCESS_KEY=
IMPORTER_S3_BUCKET_NAME=
IMPORTER_S3_PREFIX=onyx-files
IMPORTER_S3_VERIFY_SSL=true
IMPORTER_AWS_REGION=

# Standard AWS credential chain used by RDS IAM and AWS S3. Prefer short-lived
# credentials; all three values are required when the credentials are temporary.
IMPORTER_AWS_ACCESS_KEY_ID=
IMPORTER_AWS_SECRET_ACCESS_KEY=
IMPORTER_AWS_SESSION_TOKEN=

# Match production indexing. Cloud embeddings are the lightweight/default deployment path.
IMPORTER_DISABLE_MODEL_SERVER=true
IMPORTER_MODEL_SERVER_HOST=
IMPORTER_MODEL_SERVER_PORT=9000
IMPORTER_INDEXING_MODEL_SERVER_HOST=
IMPORTER_INDEXING_MODEL_SERVER_PORT=9000
IMPORTER_ENABLE_CONTEXTUAL_RAG=true

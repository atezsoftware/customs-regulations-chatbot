# Non-secret release/topology input checklist for regulatory production.
# Merge these keys into the one full mode-0600 `.env` that also contains the
# base service secrets/provider configuration. Do not deploy this template as a
# standalone --env-file. Every image value is a reviewed repository@sha256 digest.

# Full lowercase Git commit SHA recorded in the promoted image labels.
REGULATORY_SOURCE_REVISION=
REGULATORY_RELEASE_PLATFORM=linux/amd64

# Select exactly one topology in the authoritative preflight/deploy scripts:
# compose-managed -> PostgreSQL/Elasticsearch/Redis/MinIO run in this Compose project
# external -> those four services are supplied through approved private endpoints
REGULATORY_INFRA_MODE=compose-managed
REGULATORY_COMPOSE_PROJECT_NAME=onyx

# Required host file containing the archived IAM capability attestation. It is
# bind-mounted read-only at /run/readiness/regulatory-capabilities.json and must
# be numeric owner 1001:1001 with mode 0600.
REGULATORY_CAPABILITY_ATTESTATION_FILE=

# COMPOSE_PROFILES must be unset (do not declare it here or in the process).
# Profiles are selected only by the canonical scripts.

# Cloud is the approved Customs Regulations production mode. It applies the
# fixed no-local-models overlay; embedding must be configured through a cloud
# provider in Search Settings before production traffic is opened.
REGULATORY_MODEL_MODE=cloud

# Application release set emitted by publish-regulatory-images.sh.
ONYX_BACKEND_LITE_IMAGE=
ONYX_WEB_SERVER_IMAGE=
# Required only for an explicitly approved local-model deployment. Leave unset
# in cloud mode so no CUDA-backed model artifact enters the production release.
# ONYX_MODEL_SERVER_IMAGE=

# Edge images are Compose-managed in both topology modes.
REGULATORY_NGINX_IMAGE=
REGULATORY_CERTBOT_IMAGE=

# Required only for REGULATORY_INFRA_MODE=compose. DevOps supplies approved
# third-party/mirrored digests; publish-regulatory-images.sh does not publish them.
REGULATORY_POSTGRES_IMAGE=
REGULATORY_ELASTICSEARCH_IMAGE=
REGULATORY_REDIS_IMAGE=
REGULATORY_MINIO_IMAGE=

# Importer image intentionally omitted: it must never enter production config.

# Copy to `.env.web` beside the production Compose files. This file is loaded
# only by the Next.js web proxy and must remain non-secret. Do not add database,
# object-store, provider, signing, encryption, or OAuth client credentials.

INTERNAL_URL=http://api_server:8080
DISABLE_ONYX_UPSTREAM_CONNECTIONS=true
NEXT_PUBLIC_DISABLE_ONYX_UPSTREAM_CONNECTIONS=true
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=true
LICENSE_ENFORCEMENT_ENABLED=false

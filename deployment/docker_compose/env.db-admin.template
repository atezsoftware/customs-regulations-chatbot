# Copy to `.env.db-admin`, provision through the production secret store, and
# chmod 600. This file is loaded only by the Compose-managed PostgreSQL
# container. It must never be included in common `.env`, migration, or importer
# configuration. On an existing data volume these values do not create or
# rotate roles; the DBA must audit/provision ownership and grants separately.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

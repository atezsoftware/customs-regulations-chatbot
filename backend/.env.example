# local | development | test | production — controls JWT_SECRET enforcement,
# the dev auth-bypass (see src/common/env.ts and src/common/auth/current-user.ts).
NODE_ENV=local
# Set to true only in a trusted environment. Dataset uploads, deletes and
# index actions are then available to admin users (never regular users).
DATASET_MANAGEMENT_ENABLED=false

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=customs_dev
DB_PASSWORD=change-me-dev
DB_NAME=customs_dev

JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded directory files are stored on disk.
STORAGE_ROOT=./storage

# Internal services. CORE_INDEXER_URL is required for dataset chunking and
# indexing when DATASET_MANAGEMENT_ENABLED=true outside local.
CORE_INTERNAL_URL=ws://127.0.0.1:8000
CORE_INDEXER_URL=http://127.0.0.1:8001
CORE_INTERNAL_TOKEN=

# Required when OpenRouter-backed model sync is enabled.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-3.6-flash
OPENROUTER_CATALOG_SYNC_MINUTES=60
